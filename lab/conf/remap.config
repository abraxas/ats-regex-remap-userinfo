# Three vhosts, one subst shape each. remap_required stays 1 (not an open relay).
map http://lab-slash.example http://good-origin:8080 @plugin=regex_remap.so @pparam=rules
map http://lab-noslash.example http://good-origin:8080 @plugin=regex_remap.so @pparam=rules-noslash
map http://lab-dollar.example http://good-origin:8080 @plugin=regex_remap.so @pparam=rules-dollar
